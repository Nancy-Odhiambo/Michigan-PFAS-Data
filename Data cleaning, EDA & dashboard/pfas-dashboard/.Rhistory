summarise(
pct_detected  = round(100 * mean(Hazard_Index > 0, na.rm = TRUE), 1),
mean_hazard   = round(mean(Hazard_Index, na.rm = TRUE), 2),
p90_hazard    = round(quantile(Hazard_Index, 0.90, na.rm = TRUE), 3),
max_value     = round(max(Hazard_Index, na.rm = TRUE), 2),
n_locations   = n(),
water_systems = n_distinct(system_name),
.groups = "drop"
) |>
arrange(aquifer_label)
hazard_by_aquifer
# Mean Hazard Index per aquifer type, sensitive to a few extreme hotspot locations
ggplot(hazard_by_aquifer, aes(x = aquifer_label, y = mean_hazard)) +
geom_col(fill = "darkorange", width = 0.7) +
coord_flip() +
scale_x_discrete(limits = rev) +
labs(title = "Mean Hazard Index by Aquifer Type", x = NULL, y = "Mean Hazard Index") +
theme_minimal()
# Share of locations with any detectable PFAS -- replaces median, which is 0 everywhere
ggplot(hazard_by_aquifer, aes(x = aquifer_label, y = pct_detected)) +
geom_col(fill = "#2a78d6", width = 0.7) +
coord_flip() +
scale_x_discrete(limits = rev) +
labs(title = "Percent of Locations with Detectable PFAS by Aquifer Type", x = NULL, y = "% Locations Detected") +
theme_minimal()
# 90th percentile Hazard Index per aquifer type -- how bad it gets for the worse 10%
ggplot(hazard_by_aquifer, aes(x = aquifer_label, y = p90_hazard)) +
geom_col(fill = "#1baf7a", width = 0.7) +
coord_flip() +
scale_x_discrete(limits = rev) +
labs(title = "90th Percentile Hazard Index by Aquifer Type", x = NULL, y = "90th Percentile Hazard Index") +
theme_minimal()
# Max Hazard Index per aquifer type, the worst single location, a precautionary read
ggplot(hazard_by_aquifer, aes(x = aquifer_label, y = max_value)) +
geom_col(fill = "#eb6834", width = 0.7) +
coord_flip() +
scale_x_discrete(limits = rev) +
labs(title = "Max Hazard Index by Aquifer Type", x = NULL, y = "Max Hazard Index") +
theme_minimal()
# system_short = short code (e.g. SCH, MUN) standing in for the long system_type description
hazard_by_system_type <- location_level |>
group_by(system_short) |>
summarise(
mean_hazard   = round(mean(Hazard_Index, na.rm = TRUE), 2),
median_hazard = round(median(Hazard_Index, na.rm = TRUE), 2),
n_locations   = n(),
water_systems = n_distinct(system_name),
.groups = "drop"
) |>
arrange(desc(mean_hazard))
hazard_by_system_type
ggplot(hazard_by_system_type, aes(x = reorder(system_short, mean_hazard), y = mean_hazard)) +
geom_col(fill = "darkorange", width = 0.7) +
coord_flip() +
labs(
title = "Mean Hazard Index by System Type",
x = NULL, y = "Mean Hazard Index"
) +
theme_minimal()
# distance_to_nearest_site_m = straight-line distance to the single closest known PFAS site
location_level |>
summarise(
min_dist_m    = round(min(distance_to_nearest_site_m, na.rm = TRUE), 0),
median_dist_m = round(median(distance_to_nearest_site_m, na.rm = TRUE), 0),
mean_dist_m   = round(mean(distance_to_nearest_site_m, na.rm = TRUE), 0),
max_dist_m    = round(max(distance_to_nearest_site_m, na.rm = TRUE), 0)
)
# n_locations = sampling locations with vs. without a known site within 5km
location_level |>
count(pfas_site_nearby, name = "n_locations") |>
mutate(pct = round(100 * n_locations / sum(n_locations), 1))
# n_locations = sampling locations whose single nearest site is of that type
location_level |>
filter(!is.na(nearest_site_type)) |>
count(nearest_site_type, name = "n_locations", sort = TRUE)
# water_systems = distinct utilities with vs. without a known site nearby
location_level |>
group_by(pfas_site_nearby) |>
summarise(
mean_hazard   = mean(Hazard_Index, na.rm = TRUE),
median_hazard = median(Hazard_Index, na.rm = TRUE),
n_locations   = n(),
water_systems = n_distinct(system_name),
.groups = "drop"
)
ggplot(location_level, aes(x = pfas_site_nearby, y = Hazard_Index, fill = pfas_site_nearby)) +
geom_boxplot(width = 0.5) +
scale_fill_manual(values = c("TRUE" = "#eb6834", "FALSE" = "#2a78d6"), guide = "none") +
labs(
title = "Hazard Index: Locations Near vs. Not Near a Known PFAS Site",
x = "PFAS site within 5 km", y = "Hazard Index"
) +
theme_minimal()
ggplot(location_level, aes(x = distance_to_nearest_site_m, y = Hazard_Index)) +
geom_point(color = "#2a78d6", alpha = 0.5) +
labs(
title = "Hazard Index vs. Distance to Nearest Known PFAS Site",
x = "Distance to nearest site (m)", y = "Hazard Index"
) +
theme_minimal()
# n_locations = sampling locations in each aquifer x proximity combination
location_level |>
filter(!is.na(aquifer_label)) |>
count(aquifer_label, pfas_site_nearby, name = "n_locations") |>
pivot_wider(names_from = pfas_site_nearby, values_from = n_locations, values_fill = 0)
# Same cross-tab, but water_systems = distinct utilities instead of sampling locations
location_level |>
filter(!is.na(aquifer_label)) |>
distinct(system_name, aquifer_label, pfas_site_nearby) |>
count(aquifer_label, pfas_site_nearby, name = "water_systems") |>
pivot_wider(names_from = pfas_site_nearby, values_from = water_systems, values_fill = 0)
# One row per system_name: worst reading, typical reading, spread, and closest known-site distance
system_hazard <- location_level |>
group_by(system_name, system_type) |>
summarise(
n_hex_ids               = n(),
max_hazard              = round(max(Hazard_Index, na.rm = TRUE), 2),
mean_hazard             = round(mean(Hazard_Index, na.rm = TRUE), 2),
hazard_range            = round(max_hazard - min(Hazard_Index, na.rm = TRUE), 2),
min_distance_to_site_m  = round(min(distance_to_nearest_site_m, na.rm = TRUE)),
.groups = "drop"
) |>
arrange(desc(max_hazard))
nrow(system_hazard)   # should equal n_water_systems, not n_hex_ids
system_hazard
# Top 15 worst-affected systems by their single highest Hazard Index reading
top_systems <- system_hazard |> slice_head(n = 15)
ggplot(top_systems, aes(x = reorder(system_name, max_hazard), y = max_hazard)) +
geom_col(fill = "#eb6834") +
coord_flip() +
labs(
title = "Water Systems with the Highest Hazard Index",
x = NULL, y = "Max Hazard Index (worst sampling location)"
) +
theme_minimal()
# n_systems_above_alert = systems with at least one reading at/above the EPA limit
# (Hazard_Index = 1 means combined exposure across the four PFAS chemicals equals
# their EPA health-based reference level; above 1 means it exceeds that limit)
HAZARD_ALERT_THRESHOLD <- 1
system_hazard |>
summarise(
n_water_systems       = n(),
n_systems_above_alert = sum(max_hazard > HAZARD_ALERT_THRESHOLD),
pct_above_alert       = round(100 * mean(max_hazard > HAZARD_ALERT_THRESHOLD), 1)
)
# Only systems with more than one sampling location have a "spread" to measure
multi_location_systems <- location_level |>
group_by(system_name) |>
filter(n() > 1) |>
summarise(
n_hex_ids    = n(),
hazard_range = round(max(Hazard_Index) - min(Hazard_Index), 2),
hazard_sd    = round(sd(Hazard_Index), 2),
.groups = "drop"
)
nrow(multi_location_systems)   # how many systems this check even applies to
# max_spread_m = farthest distance between any two of a system's own sampling points
system_spread <- water_locations_proj |>
left_join(public_water1 |> distinct(hex_id, system_name), by = "hex_id") |>
semi_join(multi_location_systems, by = "system_name") |>
group_by(system_name) |>
group_modify(~ tibble(max_spread_m = as.numeric(max(st_distance(.x))))) |>
ungroup()
multi_location_systems |>
left_join(system_spread, by = "system_name") |>
arrange(desc(hazard_range))
# log1p handles Hazard_Index == 0 safely (log(0) is undefined, log1p(0) = 0)
model_data <- system_hazard |>
filter(!is.na(min_distance_to_site_m)) |>
mutate(log_hazard = log1p(max_hazard))
# Compare raw vs. log-transformed distributions to check the log fixed the right-skew
model_data |>
summarise(
mean_hazard        = round(mean(max_hazard), 2),
median_hazard      = round(median(max_hazard), 2),
mean_log_hazard    = round(mean(log_hazard), 2),
median_log_hazard  = round(median(log_hazard), 2)
)
ggplot(model_data, aes(x = log_hazard)) +
geom_histogram(fill = "#2a78d6", bins = 30) +
labs(
title = "Distribution of log(1 + Max Hazard Index) by Water System",
x = "log(1 + Max Hazard Index)", y = "Number of water systems"
) +
theme_minimal()
# x = log(1 + raw distance): no cap applied, the full distance range is used as-is
model_data <- model_data |>
mutate(log_distance = log1p(min_distance_to_site_m))
# Compare raw distance vs. its log to see how much the log compresses the range
model_data |>
summarise(
min_dist_m   = round(min(min_distance_to_site_m), 0),
max_dist_m   = round(max(min_distance_to_site_m), 0),
min_log_dist = round(min(log_distance), 2),
max_log_dist = round(max(log_distance), 2)
)
ggplot(model_data, aes(x = min_distance_to_site_m, y = log_distance)) +
geom_point(color = "#1baf7a", alpha = 0.4) +
labs(
title = "Distance to Nearest PFAS Site vs. log(1 + Distance)",
x = "Distance to nearest site (m)", y = "log(1 + Distance)"
) +
theme_minimal()
# Recipe: log both the raw distance and the outcome (log-log model), no distance cap
pfas_recipe <- recipe(max_hazard ~ min_distance_to_site_m, data = model_data) |>
step_log(min_distance_to_site_m, offset = 1) |>
step_log(max_hazard, offset = 1)
# Model spec: ordinary least squares via the "lm" engine, one predictor = "simple" regression
lm_spec <- linear_reg() |> set_engine("lm")
# Workflow bundles the recipe (preprocessing) and the model spec together
pfas_workflow <- workflow() |>
add_recipe(pfas_recipe) |>
add_model(lm_spec)
pfas_fit <- fit(pfas_workflow, data = model_data)
# per 1% change in (1 + distance)
tidy(pfas_fit)
# glance() = one-row model fit summary (R-squared, adjusted R-squared, etc.)
glance(pfas_fit)
ggplot(model_data, aes(x = log_distance, y = log_hazard)) +
geom_point(color = "#2a78d6", alpha = 0.4) +
geom_smooth(method = "lm", color = "#eb6834", se = TRUE) +
labs(
title = "log(Max Hazard Index) vs. log(1 + Distance to Nearest PFAS Site)",
x = "log(1 + Distance to nearest site)", y = "log(1 + Max Hazard Index)"
) +
theme_minimal()
# One row per system with every candidate predictor; aquifer = first non-missing among its locations
system_features <- location_level |>
group_by(system_name, system_short) |>
summarise(
n_hex_ids              = n(),
max_hazard             = max(Hazard_Index, na.rm = TRUE),  # unrounded so tiny readings still count as detected
min_distance_to_site_m = min(distance_to_nearest_site_m, na.rm = TRUE),
max_sites_within_5km   = max(n_sites_within_5km, na.rm = TRUE),
aquifer_label          = first(na.omit(aquifer_label)),
.groups = "drop"
)
# detected = hurdle outcome ("yes" is the SECOND level so coefficients describe the odds of detection)
hurdle_data <- system_features |>
filter(!is.na(aquifer_label)) |>
mutate(
detected   = factor(if_else(max_hazard > 0, "yes", "no"), levels = c("no", "yes")),
log_hazard = log1p(max_hazard)
)
# n_water_systems = rows kept; n_detected = systems that cleared the hurdle
hurdle_data |>
summarise(
n_water_systems = n(),
n_detected      = sum(detected == "yes"),
pct_detected    = round(100 * mean(detected == "yes"), 1)
)
# Log the distance, lump rare system types into "other", dummy-code the categoricals
detect_recipe <- recipe(
detected ~ min_distance_to_site_m + max_sites_within_5km + n_hex_ids + aquifer_label + system_short,
data = hurdle_data
) |>
step_log(min_distance_to_site_m, offset = 1) |>
step_other(system_short, threshold = 0.05) |>
step_dummy(all_nominal_predictors())
# Logistic regression via the "glm" engine; coefficients describe the odds of "yes" (detected)
detect_fit <- workflow() |>
add_recipe(detect_recipe) |>
add_model(logistic_reg() |> set_engine("glm")) |>
fit(data = hurdle_data)
# exponentiate = TRUE turns estimates into odds ratios (>1 raises the odds of detecting PFAS)
tidy(detect_fit, exponentiate = TRUE) |> arrange(p.value)
# Same predictors, fit only on systems with max_hazard > 0
severity_data <- hurdle_data |> filter(max_hazard > 0)
severity_recipe <- recipe(
log_hazard ~ min_distance_to_site_m + max_sites_within_5km + n_hex_ids + aquifer_label + system_short,
data = severity_data
) |>
step_log(min_distance_to_site_m, offset = 1) |>
step_other(system_short, threshold = 0.05) |>
step_dummy(all_nominal_predictors())
severity_fit <- workflow() |>
add_recipe(severity_recipe) |>
add_model(linear_reg() |> set_engine("lm")) |>
fit(data = severity_data)
tidy(severity_fit) |> arrange(p.value)
# One-row fit summary for the severity model
glance(severity_fit)
# detected_yes = 0/1 outcome for glm; rare system types lumped into OTHER
selection_data <- hurdle_data |>
mutate(
detected_yes = as.integer(max_hazard > 0),
log_distance = log1p(min_distance_to_site_m),
system_group = fct_lump_prop(system_short, prop = 0.05, other_level = "OTHER")
)
# Full logistic model with every candidate variable
detect_full <- glm(
detected_yes ~ log_distance + max_sites_within_5km + n_hex_ids + aquifer_label + system_group,
data = selection_data, family = binomial
)
# One test per whole variable (categoricals tested as a group, not per category)
drop1(detect_full, test = "Chisq")
# Backward selection by AIC; stats:: is needed because tidymodels masks step(); n_hex_ids is kept as a control
detect_reduced <- stats::step(detect_full, scope = list(lower = ~ n_hex_ids),
direction = "backward", trace = 0)
formula(detect_reduced)   # the variables that survived
# Odds ratios for the surviving variables (>1 raises the odds of detecting PFAS)
tidy(detect_reduced, exponentiate = TRUE) |> arrange(p.value)
glance(detect_reduced)
# Same candidates for severity, fit only on systems with max_hazard > 0
severity_selection_data <- selection_data |> filter(max_hazard > 0)
severity_full <- lm(
log_hazard ~ log_distance + max_sites_within_5km + n_hex_ids + aquifer_label + system_group,
data = severity_selection_data
)
drop1(severity_full, test = "F")
# Backward selection by AIC for severity (stats:: because tidymodels masks step())
severity_reduced <- stats::step(severity_full, scope = list(lower = ~ n_hex_ids),
direction = "backward", trace = 0)
formula(severity_reduced)   # the variables that survived
tidy(severity_reduced) |> arrange(p.value)
glance(severity_reduced)
# Refit the step() survivors through parsnip; the formula is taken from the selected model
detect_final_fit <- logistic_reg() |>
set_engine("glm") |>
fit(update(formula(detect_reduced), detected ~ .), data = selection_data)
tidy(detect_final_fit, exponentiate = TRUE) |> arrange(p.value)
severity_final_fit <- linear_reg() |>
set_engine("lm") |>
fit(formula(severity_reduced), data = severity_selection_data)
tidy(severity_final_fit) |> arrange(p.value)
# Same predictors as Part 1; normalize is required so the penalty treats all variables fairly
detect_recipe_lasso <- recipe(
detected ~ min_distance_to_site_m + max_sites_within_5km + n_hex_ids + aquifer_label + system_short,
data = hurdle_data
) |>
step_log(min_distance_to_site_m, offset = 1) |>
step_other(system_short, threshold = 0.05) |>
step_dummy(all_nominal_predictors()) |>
step_zv(all_predictors()) |>
step_normalize(all_numeric_predictors())
# penalty = tune() lets cross-validation pick how aggressively to drop; mixture = 1 means LASSO
detect_lasso_wf <- workflow() |>
add_recipe(detect_recipe_lasso) |>
add_model(logistic_reg(penalty = tune(), mixture = 1) |> set_engine("glmnet"))
set.seed(123)
detect_folds <- vfold_cv(hurdle_data, v = 10, strata = detected)
detect_tuned <- tune_grid(
detect_lasso_wf,
resamples = detect_folds,
grid      = grid_regular(penalty(range = c(-4, -0.5)), levels = 20),
metrics   = metric_set(roc_auc)
)
# Simplest model (largest penalty) within one standard error of the best
detect_best <- select_by_one_std_err(detect_tuned, desc(penalty), metric = "roc_auc")
detect_lasso_fit <- finalize_workflow(detect_lasso_wf, detect_best) |>
fit(data = hurdle_data)
# Variables with a nonzero estimate survived; zeros were dropped
tidy(detect_lasso_fit) |> filter(estimate != 0)
# Severity LASSO on detected systems only (severity_data defined in Part 2)
severity_recipe_lasso <- recipe(
log_hazard ~ min_distance_to_site_m + max_sites_within_5km + n_hex_ids + aquifer_label + system_short,
data = severity_data
) |>
step_log(min_distance_to_site_m, offset = 1) |>
step_other(system_short, threshold = 0.05) |>
step_dummy(all_nominal_predictors()) |>
step_zv(all_predictors()) |>
step_normalize(all_numeric_predictors())
severity_lasso_wf <- workflow() |>
add_recipe(severity_recipe_lasso) |>
add_model(linear_reg(penalty = tune(), mixture = 1) |> set_engine("glmnet"))
set.seed(123)
severity_folds <- vfold_cv(severity_data, v = 5)
severity_tuned <- tune_grid(
severity_lasso_wf,
resamples = severity_folds,
grid      = grid_regular(penalty(range = c(-4, -0.5)), levels = 20),
metrics   = metric_set(rmse)
)
severity_best <- select_by_one_std_err(severity_tuned, desc(penalty), metric = "rmse")
severity_lasso_fit <- finalize_workflow(severity_lasso_wf, severity_best) |>
fit(data = severity_data)
# Variables with a nonzero estimate survived; zeros were dropped
tidy(severity_lasso_fit) |> filter(estimate != 0)
# Only the layers used in this analysis
st_layers("gSSURGO_MI.gdb") |>
as_tibble() |>
filter(name %in% c("MUPOLYGON", "mapunit", "muaggatt", "Valu1", "component", "chorizon"))
# Only the layers used in this analysis
tibble(layer_name = st_layers("gSSURGO_MI.gdb")$name,
features   = st_layers("gSSURGO_MI.gdb")$features) |>
filter(layer_name %in% c("MUPOLYGON", "mapunit", "muaggatt", "Valu1", "component", "chorizon"))
# One row per soil map unit: map unit names and status
mapunit <- st_read("gSSURGO_MI.gdb", layer = "mapunit", quiet = TRUE) |> as_tibble()
glimpse(mapunit)
# One row per map unit: aggregated soil properties (drainage, water table, bedrock depth, etc.)
muaggatt <- st_read("gSSURGO_MI.gdb", layer = "muaggatt", quiet = TRUE) |> as_tibble()
glimpse(muaggatt)
# One row per map unit: pre-computed values (organic carbon, available water, crop indices)
valu1 <- st_read("gSSURGO_MI.gdb", layer = "Valu1", quiet = TRUE) |> as_tibble()
glimpse(valu1)
# One row per soil component (several components can share a map unit)
component <- st_read("gSSURGO_MI.gdb", layer = "component", quiet = TRUE) |> as_tibble()
glimpse(component)
# One row per soil horizon (layer) of a component; holds the permeability column ksat_r
chorizon <- st_read("gSSURGO_MI.gdb", layer = "chorizon", quiet = TRUE) |> as_tibble()
glimpse(chorizon)
# Per component: harmonic-mean ksat over the top 100 cm layers in series, so the tightest layer limits flow
component_ksat <- chorizon |>
mutate(thick_cm = pmax(0, pmin(hzdepb_r, 100) - pmax(hzdept_r, 0))) |>
filter(thick_cm > 0, !is.na(ksat_r), ksat_r > 0) |>
group_by(cokey) |>
summarise(ksat_100cm = sum(thick_cm) / sum(thick_cm / ksat_r), .groups = "drop")
# Per map unit: components weighted by their percent of the map unit, then the standard NRCS classes
soil_perm <- component |>
inner_join(component_ksat, by = "cokey") |>
group_by(mukey) |>
summarise(ksat_100cm = weighted.mean(ksat_100cm, comppct_r, na.rm = TRUE), .groups = "drop") |>
mutate(
perm_class = cut(
ksat_100cm,
breaks = c(0, 0.01, 0.1, 1, 10, 100, Inf), right = FALSE,
labels = c("Very low", "Low", "Moderately low", "Moderately high", "High", "Very high")
),
perm_code = as.integer(perm_class)
)
glimpse(soil_perm)
# n_mukeys_with_ksat = map units that ended up with a permeability value; then the spread of values
soil_perm |>
summarise(
n_mukeys_with_ksat = n(),
min_ksat    = round(min(ksat_100cm), 3),
median_ksat = round(median(ksat_100cm), 2),
mean_ksat   = round(mean(ksat_100cm), 2),
max_ksat    = round(max(ksat_100cm), 1)
)
# Distribution of map-unit permeability; log scale because values span several orders of magnitude
soil_perm |>
ggplot(aes(x = ksat_100cm)) +
geom_histogram(bins = 40, fill = "#2a78d6") +
scale_x_log10() +
labs(
title = "Soil Permeability of Michigan Map Units (top 100 cm)",
x = "ksat, top 100 cm (micrometers per second, log scale)", y = "Number of map units"
) +
theme_minimal()
# The 1.2M-polygon read and rasterize is slow, so the 1 km grid is cached to an RDS file
if (file.exists("soil_perm_raster.rds")) {
perm_raster_df <- readRDS("soil_perm_raster.rds")
} else {
soil_vect <- terra::vect("gSSURGO_MI.gdb", layer = "MUPOLYGON",
query = "SELECT MUKEY FROM MUPOLYGON")
soil_vect$perm_code <- soil_perm$perm_code[match(soil_vect$MUKEY, soil_perm$mukey)]
perm_grid   <- terra::rast(terra::ext(soil_vect), resolution = 1000, crs = terra::crs(soil_vect))
perm_raster <- terra::rasterize(soil_vect, perm_grid, field = "perm_code")
perm_raster_df <- as.data.frame(perm_raster, xy = TRUE) |>
as_tibble() |>
set_names(c("x", "y", "perm_code"))
saveRDS(perm_raster_df, "soil_perm_raster.rds")
}
# Statewide soil permeability class on a 1 km grid
perm_raster_df |>
mutate(perm_class = factor(perm_code, levels = 1:6, labels = levels(soil_perm$perm_class))) |>
ggplot(aes(x = x, y = y, fill = perm_class)) +
geom_raster() +
scale_fill_viridis_d(name = "Permeability", direction = -1) +
coord_equal() +
labs(title = "Soil Permeability in the Top 100 cm (gSSURGO)") +
theme_void()
# pct_missing per soil attribute (urban and water map units often carry no soil data)
water_soil |>
summarise(across(
c(drclassdcd, hydgrpdcd, wtdepannmin, brockdepmin, slopegradwta,
soc0_150, aws0_150, droughty, ksat_100cm),
~ round(mean(is.na(.x)) * 100, 1)
))
# Sampling locations colored by the permeability class of the soil they sit on
water_locations |>
left_join(water_soil |> select(hex_id, perm_class), by = "hex_id") |>
ggplot() +
geom_sf(data = aquifer, fill = "grey95", color = "grey75") +
geom_sf(aes(color = perm_class), size = 1.5) +
scale_color_viridis_d(name = "Permeability", direction = -1, na.value = "#eb6834") +
labs(title = "Public-water sampling locations by soil permeability") +
theme_minimal()
# Share of the whole state (by area) in each permeability class, from the full 1 km grid
state_share <- perm_raster_df |>
filter(!is.na(perm_code)) |>
count(perm_code, name = "n_cells") |>
mutate(
perm_class = factor(perm_code, levels = 1:6, labels = levels(soil_perm$perm_class)),
share      = n_cells / sum(n_cells),
source     = "Whole state (by area)"
)
# Share of sampling locations sitting on each permeability class
site_share <- water_soil |>
filter(!is.na(perm_class)) |>
count(perm_class, name = "n_locations") |>
mutate(
share  = n_locations / sum(n_locations),
source = "Water sampling locations"
)
# Side-by-side comparison of the two shares
bind_rows(
select(state_share, perm_class, share, source),
select(site_share,  perm_class, share, source)
) |>
ggplot(aes(x = perm_class, y = share, fill = source)) +
geom_col(position = "dodge") +
scale_y_continuous(labels = scales::percent) +
scale_fill_manual(values = c("Whole state (by area)" = "#2a78d6",
"Water sampling locations" = "#eb6834")) +
labs(
title = "Soil permeability: whole state vs. sampling locations",
x = "Permeability class", y = "Share", fill = NULL
) +
theme_minimal()

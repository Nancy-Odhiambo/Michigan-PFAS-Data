"<b>County:</b> ", county
)
)
# Crosstalk SharedData
sd_sites <- SharedData$new(pfas_sites_sf, key = ~facility, group = "pfas")
# Load Michigan counties shapefile
mi_counties <- st_read("GeoFiles/cb_2018_us_county_500k.shp", quiet = TRUE) %>%
filter(STATEFP == "26") %>%
st_transform(4326)
# Viridis palette
pal <- colorFactor("viridis", pfas_sites_sf$type)
# Crosstalk filter UI (placed ABOVE map)
filter_ui <- filter_select(
id = "type_filter",
label = "Search by Site Type",
sharedData = sd_sites,
group = ~type
)
# Leaflet map (full width)
map <- leaflet(sd_sites) %>%
setView(lng = -84.5, lat = 44.5, zoom = 5.5) %>%
addProviderTiles(providers$CartoDB.Positron) %>%
addPolygons(
data = mi_counties,
fillColor = "grey",
color = "black",
weight = 1,
fillOpacity = 0.3
) %>%
addCircleMarkers(
lng = ~longitude, lat = ~latitude,
radius = 4,
fillColor = ~pal(type),
stroke = FALSE,
fillOpacity = 0.8,
popup = ~popup_label,
label = ~lapply(popup_label, htmltools::HTML)
) %>%
addLegendFactor(
pal = pal,
values = pfas_sites_sf$type,
title = "Contamination Site Type",
position = "topright",
shape = "circle",
width = 8,
height = 8,
fillOpacity = 0.8
)
# Display filter ABOVE map (full width)
tagList(
div(style = "margin-bottom: 10px;", filter_ui),
div(style = "width: 100%;", map)
)
# Visualizing the type of site by the composition of 4 main analytes with the hazard index
hazard_data_analytes <- merged_data |>
inner_join(
hazard_data_types |> select(hex_id, type, Hazard_Index),
by = c("hex_id", "type", "Hazard_Index")
) |>
distinct(hex_id, type, analyte, analyte_value, Hazard_Index) |>
filter(analyte %in% hazard_analytes)
# Summarize total hazard and analyte sums by type
hazard_summary_by_type <- hazard_data_analytes |>
group_by(type, analyte) |>
summarise(sum_analyte = sum(analyte_value, na.rm = TRUE), .groups = "drop") |>
left_join(
hazard_data_analytes |>
group_by(type) |>
summarise(
total_hazard = sum(Hazard_Index, na.rm = TRUE),
n_sites = n_distinct(hex_id),
.groups = "drop"
),
by = "type"
) |>
pivot_wider(
names_from = analyte,
values_from = sum_analyte,
values_fill = 0
) |>
mutate(across(where(is.numeric), ~ round(.x, 2))) |>
arrange(desc(total_hazard))
# Assign a unique ID for reactable
tbl_id <- "hazard_summary_table"
# Create the interactive table with custom headers
rt <- reactable(
hazard_summary_by_type,
elementId = tbl_id,
searchable = TRUE,
filterable = TRUE,
showPageSizeOptions = TRUE,
defaultPageSize = 10,
highlight = TRUE,
bordered = TRUE,
striped = TRUE,
columns = list(
type = colDef(name = "TYPE"),
total_hazard = colDef(name = "TOTAL HAZARD"),
n_sites = colDef(name = "N SITES")
)
)
# Create download link-style button in top-right
download_btn <- tags$button(
"Download CSV",
onclick = sprintf("Reactable.downloadDataCSV('%s', 'hazard_summary_by_type.csv')", tbl_id),
style = "
background: none;
border: none;
color: #0073e6;
text-decoration: underline;
cursor: pointer;
font-size: 0.9em;
float: right;
margin-bottom: 5px;
"
)
# Display table with download link above it
browsable(tagList(download_btn, rt))
# Section tests
# Dominant PFAS analytes in Michigan surface water
top10_analyte <- surface_max_full %>%
filter(
!is.na(analyte),
analyte_value > 0
) %>%
group_by(analyte) %>%
summarise(
total_concentration = sum(analyte_value, na.rm = TRUE),
sampling_sites = n_distinct(site_code),
.groups = "drop"
) %>%
mutate(
contribution = total_concentration / sum(total_concentration)
) %>%
slice_max(
total_concentration,
n = 10
) %>%
arrange(total_concentration)
plot_ly(
data = top10_analyte,
x = ~contribution,
y = ~forcats::fct_reorder(analyte, contribution),
type = "bar",
orientation = "h",
marker = list(
color = ~contribution,
colorscale = "Cividis",
line = list(
color = "white",
width = 1.2
)
),
hoverinfo = "text",
hovertext = ~paste0(
"<b>", analyte, "</b><br><br>",
"<b>Total Concentration:</b> ",
scales::comma(round(total_concentration, 1)),
" ppt<br>",
"<b>Contribution:</b> ",
round(contribution * 100, 2),
"%<br>",
"<b>Sampling Sites:</b> ",
sampling_sites
)
) |>
layout(
title = list(
text = "<b>Dominant PFAS Analytes in Michigan Surface Water</b>",
x = 0.02
),
xaxis = list(
title = "<b>Share of Total PFAS</b>",
tickformat = ".0%"
),
yaxis = list(
title = ""
),
margin = list(
l = 140,
r = 40,
t = 70,
b = 50
),
hoverlabel = list(
bgcolor = "lightyellow",
bordercolor = "orange",
font = list(
color = "black",
size = 12
),
namelength = 0
),
showlegend = FALSE) |>
onRender(js_auto_hover)
# Michigan counties
mi_counties <- suppressMessages(
st_read("cb_2018_us_county_500k.shp", quiet = TRUE)
) |>
filter(STATEFP == "26") |>
st_transform(4326) |>
mutate(
GEOID = as.character(GEOID)
)
# Aggregate surface water PFAS concentration by county
surface_county <- surface_max_full |>
mutate(
geoid = as.character(geoid)
) |>
group_by(geoid) |>
summarise(
total_concentration = sum(
analyte_value,
na.rm = TRUE
),
sampling_sites = n_distinct(site_code),
analytes = n_distinct(analyte),
.groups = "drop"
)
# Join county summaries with county boundaries
surface_map <- mi_counties |>
left_join(
surface_county,
by = c("GEOID" = "geoid")
)
# Remove missing values for color scale
surface_values <- surface_map$total_concentration[
!is.na(surface_map$total_concentration)
]
# Create viridis color palette
surface_pal <- colorNumeric(
palette = viridis::viridis(
256,
option = "C"
),
domain = surface_values,
na.color = "#D9D9D9"
)
# Create legend breaks
# Leaflet requires increasing values
surface_bins <- pretty(
surface_values,
n = 6
)
surface_bins <- sort(
unique(surface_bins)
)
# Interactive surface water map
surface_map_widget <- leaflet(surface_map) |>
addProviderTiles(
providers$CartoDB.Positron
) |>
addPolygons(
fillColor = ~surface_pal(total_concentration),
fillOpacity = 0.85,
color = "white",
weight = 1,
smoothFactor = 0.3,
popup = ~sprintf(
"<div style='
background:lightyellow;
color:black;
border:2px solid orange;
padding:10px;
border-radius:8px;
font-size:12px;
line-height:1.5;
'>
<b>%s County</b><br><br>
<b>Total PFAS Concentration:</b><br>
%s ppt<br><br>
<b>Sampling Sites:</b><br>
%s<br><br>
<b>Detected Analytes:</b><br>
%s
</div>",
NAME,
ifelse(
is.na(total_concentration),
"No Data",
scales::comma(
round(total_concentration, 1)
)
),
ifelse(
is.na(sampling_sites),
"No Data",
sampling_sites
),
ifelse(
is.na(analytes),
"No Data",
analytes
)
),
highlightOptions = highlightOptions(
weight = 3,
color = "orange",
fillOpacity = 1,
bringToFront = TRUE
)
) |>
addLegend(
position = "bottomleft",
title = htmltools::HTML(
"<b>Total PFAS (ppt)</b>"
),
pal = surface_pal,
values = surface_values,
bins = surface_bins,
opacity = 1
)
# Display map
surface_map_widget
# Define colors for hazard-contributing PFAS analytes
hazard_colors <- c(
"HFPODA" = "#575c6d",
"PFNA" = "#a69d75",
"PFBS" = "#ffea47",
"PFHxS" = "#00204d"
)
# Calculate top 10 PFAS analytes in public water systems
top_analytes <- public_max_full |>
filter(analyte_value > 0) |>
group_by(analyte) |>
summarise(
total_concentration = sum(analyte_value, na.rm = TRUE),
.groups = "drop"
) |>
mutate(
contribution = total_concentration / sum(total_concentration)
) |>
slice_max(total_concentration, n = 10)
# Assign pink color to non-hazard analytes
analyte_colors <- c(
hazard_colors,
setNames(
rep("pink", sum(!top_analytes$analyte %in% names(hazard_colors))),
top_analytes$analyte[!top_analytes$analyte %in% names(hazard_colors)]
)
)
# Interactive horizontal bar chart
plot_ly(
data = top_analytes,
